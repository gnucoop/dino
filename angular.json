{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "core": {
      "projectType": "library",
      "root": "projects/core",
      "sourceRoot": "projects/core",
      "prefix": "dino",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/core/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/core/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/core/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "projects/core/src/test.ts",
            "tsConfig": "projects/core/tsconfig.spec.json",
            "karmaConfig": "projects/core/karma.conf.js"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["projects/core/**/*.ts", "projects/core/**/*.html"]
          }
        },
        "cypress-run": {
          "builder": "@cypress/schematic:cypress",
          "options": {
            "devServerTarget": "dinoapp:serve:e2e",
            "configFile": "projects/core/cypress.config.ts"
          },
          "configurations": {
            "production": {
              "devServerTarget": "dinoapp:serve:production"
            }
          }
        },
        "cypress-run-ci": {
          "builder": "@cypress/schematic:cypress",
          "options": {
            "configFile": "projects/core/cypress.config.ts",
            "browser": "chrome",
            "headless": true
          },
          "configurations": {
            "production": {
              "devServerTarget": "dinoapp:serve:production"
            }
          }
        },
        "cypress-open": {
          "builder": "@cypress/schematic:cypress",
          "options": {
            "watch": true,
            "headless": false,
            "configFile": "projects/core/config.ts"
          }
        },
        "e2e": {
          "builder": "@cypress/schematic:cypress",
          "options": {
            "devServerTarget": "dinoapp:serve:e2e",
            "watch": true,
            "headless": false
          },
          "configurations": {
            "production": {
              "devServerTarget": "dinoapp:serve:production"
            }
          }
        }
      }
    },
    "material": {
      "projectType": "library",
      "root": "projects/material",
      "sourceRoot": "projects/material",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/material/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/material/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/material/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "projects/material/src/test.ts",
            "tsConfig": "projects/material/tsconfig.spec.json",
            "karmaConfig": "projects/material/karma.conf.js"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["projects/material/**/*.ts", "projects/material/**/*.html"]
          }
        },
        "cypress-run": {
          "builder": "@cypress/schematic:cypress",
          "options": {
            "devServerTarget": "dinoapp:serve:e2e",
            "configFile": "projects/material/cypress.config.ts"
          },
          "configurations": {
            "production": {
              "devServerTarget": "dinoapp:serve:production"
            }
          }
        },
        "cypress-run-ci": {
          "builder": "@cypress/schematic:cypress",
          "options": {
            "configFile": "projects/material/cypress.config.ts",
            "browser": "chrome",
            "headless": true
          },
          "configurations": {
            "production": {
              "devServerTarget": "dinoapp:serve:production"
            }
          }
        },
        "cypress-open": {
          "builder": "@cypress/schematic:cypress",
          "options": {
            "watch": true,
            "headless": false,
            "configFile": "projects/material/cypress.config.ts"
          }
        },
        "e2e": {
          "builder": "@cypress/schematic:cypress",
          "options": {
            "devServerTarget": "dinoapp:serve:e2e",
            "watch": true,
            "headless": false
          },
          "configurations": {
            "production": {
              "devServerTarget": "dinoapp:serve:production"
            }
          }
        }
      }
    },
    "e2e-app": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        },
        "@schematics/angular:application": {
          "strict": true
        }
      },
      "root": "projects/e2e-app",
      "sourceRoot": "projects/e2e-app/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/e2e-app",
            "index": "projects/e2e-app/src/index.html",
            "main": "projects/e2e-app/src/main.ts",
            "polyfills": "projects/e2e-app/src/polyfills.ts",
            "tsConfig": "projects/e2e-app/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": ["projects/e2e-app/src/favicon.ico", "projects/e2e-app/src/assets"],
            "stylePreprocessorOptions": {
              "includePaths": ["node_modules/", "node_modules/angular-material-css-vars"]
            },
            "styles": [
              "node_modules/@ajf/icons/css/ajf-icons.css",
              "node_modules/flag-icon-css/css/flag-icons.min.css",
              "node_modules/leaflet/dist/leaflet.css",
              "node_modules/leaflet.markercluster/dist/MarkerCluster.css",
              "node_modules/leaflet.markercluster/dist/MarkerCluster.Default.css",
              "node_modules/quill/dist/quill.core.css",
              "node_modules/quill/dist/quill.snow.css",
              "projects/e2e-app/src/styles.scss"
            ],
            "scripts": [],
            "allowedCommonJsDependencies": [
              "argsarray",
              "chart.js",
              "crypto-js/aes",
              "crypto-js/enc-utf8",
              "dagre",
              "deep-equal",
              "detect-node",
              "flat",
              "immediate",
              "is-my-json-valid",
              "leaflet",
              "memdown",
              "modifyjs",
              "pdfmake/build/pdfmake",
              "graphql-ws",
              "jsbarcode",
              "spark-md5",
              "svg-pan-zoom",
              "vuvuzela"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1mb",
                  "maximumError": "2mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "10kb",
                  "maximumError": "20kb"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "buildOptimizer": false,
              "optimization": false,
              "vendorChunk": true,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "e2e-app:build:production"
            },
            "development": {
              "buildTarget": "e2e-app:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    },
    "dev-app": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        },
        "@schematics/angular:application": {
          "strict": true
        }
      },
      "root": "projects/dev-app",
      "sourceRoot": "projects/dev-app/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/dev-app",
            "index": "projects/dev-app/src/index.html",
            "main": "projects/dev-app/src/main.ts",
            "polyfills": "projects/dev-app/src/polyfills.ts",
            "tsConfig": "projects/dev-app/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": ["projects/dev-app/src/favicon.ico", "projects/dev-app/src/assets"],
            "styles": [
              "node_modules/@ajf/icons/css/ajf-icons.css",
              "node_modules/@angular/material/prebuilt-themes/indigo-pink.css",
              "node_modules/flag-icon-css/css/flag-icons.min.css",
              "node_modules/leaflet/dist/leaflet.css",
              "node_modules/quill/dist/quill.core.css",
              "node_modules/quill/dist/quill.snow.css",
              "projects/dev-app/src/styles.scss"
            ],
            "scripts": [],
            "allowedCommonJsDependencies": [
              "chart.js",
              "crypto-js/aes",
              "crypto-js/enc-utf8",
              "deep-equal",
              "immediate",
              "is-my-json-valid",
              "memdown",
              "modifyjs",
              "pdfmake/build/pdfmake",
              "graphql-ws"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "4mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "200kb",
                  "maximumError": "400kb"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "buildOptimizer": false,
              "optimization": false,
              "vendorChunk": true,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "dev-app:build:production"
            },
            "development": {
              "buildTarget": "dev-app:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    },
    "dinoapp": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        },
        "@schematics/angular:application": {
          "strict": true
        }
      },
      "root": "projects/dinoapp",
      "sourceRoot": "projects/dinoapp/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "serviceWorker": true,
            "allowedCommonJsDependencies": [
              "crypto-js/aes",
              "crypto-js/enc-utf8",
              "deep-equal",
              "immediate",
              "is-my-json-valid",
              "modifyjs",
              "pdfmake/build/pdfmake",
              "graphql-ws",
              "jsbarcode",
              "uuid",
              "xlsx"
            ],
            "outputPath": "dist/dinoapp",
            "index": "projects/dinoapp/src/index.html",
            "main": "projects/dinoapp/src/main.ts",
            "polyfills": "projects/dinoapp/src/polyfills.ts",
            "tsConfig": "projects/dinoapp/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "projects/dinoapp/src/favicon.ico",
              "projects/dinoapp/src/assets",
              {
                "glob": "**/*",
                "input": "./node_modules/leaflet/dist/images",
                "output": "leaflet/"
              },
              "projects/dinoapp/src/manifest.webmanifest"
            ],
            "styles": [
              "node_modules/@ajf/icons/css/ajf-icons.css",
              "node_modules/leaflet/dist/leaflet.css",
              "node_modules/leaflet.markercluster/dist/MarkerCluster.css",
              "node_modules/leaflet.markercluster/dist/MarkerCluster.Default.css",
              "node_modules/quill/dist/quill.core.css",
              "node_modules/quill/dist/quill.snow.css",
              "projects/dinoapp/src/styles.scss"
            ],
            "stylePreprocessorOptions": {
              "includePaths": ["node_modules/"]
            },
            "scripts": [],
            "ngswConfigPath": "projects/dinoapp/ngsw-config.json"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "10mb",
                  "maximumError": "20mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "10kb",
                  "maximumError": "20kb"
                }
              ],
              "outputHashing": "all"
            },
            "digitalroadmap_prod": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "10mb",
                  "maximumError": "20mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "10kb",
                  "maximumError": "20kb"
                }
              ],
              "styles": ["projects/dinoapp/src/custom-themes/styles.pico.scss"],
              "outputHashing": "all"
            },
            "mimit-dev": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "10mb",
                  "maximumError": "20mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "10kb",
                  "maximumError": "20kb"
                }
              ],
              "styles": [
                "node_modules/flag-icon-css/css/flag-icons.min.css",
                "node_modules/leaflet/dist/leaflet.css",
                "node_modules/leaflet.markercluster/dist/MarkerCluster.css",
                "node_modules/leaflet.markercluster/dist/MarkerCluster.Default.css",
                "projects/dinoapp/src/custom-themes/styles.pico.scss"
              ],
              "outputHashing": "all"
            },
            "mimit-prod": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "10mb",
                  "maximumError": "20mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "10kb",
                  "maximumError": "20kb"
                }
              ],
              "styles": [
                "node_modules/flag-icon-css/css/flag-icons.min.css",
                "node_modules/leaflet/dist/leaflet.css",
                "node_modules/leaflet.markercluster/dist/MarkerCluster.css",
                "node_modules/leaflet.markercluster/dist/MarkerCluster.Default.css",
                "projects/dinoapp/src/custom-themes/styles.pico.scss"
              ],
              "outputHashing": "all"
            },
            "development": {
              "buildOptimizer": false,
              "optimization": false,
              "vendorChunk": true,
              "extractLicenses": false,
              "sourceMap": {
                "scripts": true,
                "styles": true,
                "hidden": false,
                "vendor": true
              },
              "namedChunks": true
            },
            "e2e": {
              "buildOptimizer": false,
              "optimization": false,
              "vendorChunk": true,
              "extractLicenses": false,
              "sourceMap": {
                "scripts": true,
                "styles": true,
                "hidden": false,
                "vendor": true
              },
              "namedChunks": true,
              "serviceWorker": false,
              "fileReplacements": [
                {
                  "replace": "projects/dinoapp/src/environments/environment.ts",
                  "with": "projects/dinoapp/src/environments/environment.e2e.ts"
                }
              ]
            },
            "docker": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "10mb",
                  "maximumError": "20mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "10kb",
                  "maximumError": "20kb"
                }
              ],
              "outputHashing": "all",
              "fileReplacements": [
                {
                  "replace": "projects/dinoapp/src/environments/environment.ts",
                  "with": "projects/dinoapp/src/environments/environment.docker.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "dinoapp:build:production"
            },
            "development": {
              "buildTarget": "dinoapp:build:development"
            },
            "e2e": {
              "buildTarget": "dinoapp:build:e2e"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "dinoapp:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "projects/dinoapp/src/test.ts",
            "polyfills": "projects/dinoapp/src/polyfills.ts",
            "tsConfig": "projects/dinoapp/tsconfig.spec.json",
            "karmaConfig": "projects/dinoapp/karma.conf.js",
            "inlineStyleLanguage": "scss",
            "assets": [
              "projects/dinoapp/src/favicon.ico",
              "projects/dinoapp/src/assets",
              {
                "glob": "**/*",
                "input": "./node_modules/leaflet/dist/images",
                "output": "leaflet/"
              },
              "projects/dinoapp/src/manifest.webmanifest"
            ],
            "styles": [
              "node_modules/flag-icon-css/css/flag-icons.min.css",
              "node_modules/leaflet/dist/leaflet.css",
              "projects/dinoapp/src/styles.scss"
            ],
            "scripts": []
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["projects/dinoapp/src/**/*.ts", "projects/dinoapp/src/**/*.html"]
          }
        }
      }
    },
    "dino-examples": {
      "projectType": "library",
      "root": "projects/dino-examples",
      "sourceRoot": "projects/dino-examples/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/dino-examples/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/dino-examples/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/dino-examples/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        }
      }
    }
  },
  "cli": {
    "cache": {
      "enabled": false
    },
    "schematicCollections": ["angular-eslint"],
    "analytics": false
  }
}
