{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "core": {
      "projectType": "library",
      "root": "projects/core",
      "sourceRoot": "projects/core",
      "prefix": "dino",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/core/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/core/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/core/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "projects/core/src/test.ts",
            "tsConfig": "projects/core/tsconfig.spec.json",
            "karmaConfig": "projects/core/karma.conf.js"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/core/**/*.ts",
              "projects/core/**/*.html"
            ]
          }
        },
        "cypress-run": {
          "builder": "@cypress/schematic:cypress",
          "options": {
            "devServerTarget": "e2e-app:serve",
            "configFile": "projects/core/cypress.config.ts"
          },
          "configurations": {
            "production": {
              "devServerTarget": "e2e-app:serve:production"
            }
          }
        },
        "cypress-run-ci": {
          "builder": "@cypress/schematic:cypress",
          "options": {
            "configFile": "projects/core/cypress.config.ts"
          },
          "configurations": {
            "production": {
              "devServerTarget": "e2e-app:serve:production"
            }
          }
        },
        "cypress-open": {
          "builder": "@cypress/schematic:cypress",
          "options": {
            "watch": true,
            "headless": false,
            "configFile": "projects/core/config.ts"
          }
        },
        "e2e": {
          "builder": "@cypress/schematic:cypress",
          "options": {
            "devServerTarget": "e2e-app:serve",
            "watch": true,
            "headless": false
          },
          "configurations": {
            "production": {
              "devServerTarget": "e2e-app:serve:production"
            }
          }
        }
      }
    },
    "material": {
      "projectType": "library",
      "root": "projects/material",
      "sourceRoot": "projects/material",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/material/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/material/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/material/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "projects/material/src/test.ts",
            "tsConfig": "projects/material/tsconfig.spec.json",
            "karmaConfig": "projects/material/karma.conf.js"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/material/**/*.ts",
              "projects/material/**/*.html"
            ]
          }
        },
        "cypress-run": {
          "builder": "@cypress/schematic:cypress",
          "options": {
            "devServerTarget": "e2e-app:serve",
            "configFile": "projects/material/cypress.config.ts"
          },
          "configurations": {
            "production": {
              "devServerTarget": "e2e-app:serve:production"
            }
          }
        },
        "cypress-run-ci": {
          "builder": "@cypress/schematic:cypress",
          "options": {
            "configFile": "projects/material/cypress.config.ts"
          },
          "configurations": {
            "production": {
              "devServerTarget": "e2e-app:serve:production"
            }
          }
        },
        "cypress-open": {
          "builder": "@cypress/schematic:cypress",
          "options": {
            "watch": true,
            "headless": false,
            "configFile": "projects/material/cypress.config.ts"
          }
        },
        "e2e": {
          "builder": "@cypress/schematic:cypress",
          "options": {
            "devServerTarget": "e2e-app:serve",
            "watch": true,
            "headless": false
          },
          "configurations": {
            "production": {
              "devServerTarget": "e2e-app:serve:production"
            }
          }
        }
      }
    },
    "e2e-app": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        },
        "@schematics/angular:application": {
          "strict": true
        }
      },
      "root": "projects/e2e-app",
      "sourceRoot": "projects/e2e-app/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/e2e-app",
            "index": "projects/e2e-app/src/index.html",
            "main": "projects/e2e-app/src/main.ts",
            "polyfills": "projects/e2e-app/src/polyfills.ts",
            "tsConfig": "projects/e2e-app/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "projects/e2e-app/src/favicon.ico",
              "projects/e2e-app/src/assets"
            ],
            "stylePreprocessorOptions": {
              "includePaths": [
                "node_modules/",
                "node_modules/angular-material-css-vars"
              ]
            },
            "styles": [
              "node_modules/@ajf/icons/css/ajf-icons.css",
              "node_modules/flag-icon-css/css/flag-icons.min.css",
              "node_modules/leaflet/dist/leaflet.css",
              "projects/e2e-app/src/styles.scss"
            ],
            "scripts": [],
            "allowedCommonJsDependencies": [
              "argsarray",
              "chart.js",
              "crypto-js/aes",
              "crypto-js/enc-utf8",
              "dagre",
              "deep-equal",
              "detect-node",
              "flat",
              "immediate",
              "is-my-json-valid",
              "leaflet",
              "memdown",
              "modifyjs",
              "numbro",
              "pdfmake/build/pdfmake",
              "graphql-ws",
              "spark-md5",
              "svg-pan-zoom",
              "vuvuzela"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1mb",
                  "maximumError": "2mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "10kb",
                  "maximumError": "20kb"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "buildOptimizer": false,
              "optimization": false,
              "vendorChunk": true,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "browserTarget": "e2e-app:build:production"
            },
            "development": {
              "browserTarget": "e2e-app:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    },
    "dev-app": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        },
        "@schematics/angular:application": {
          "strict": true
        }
      },
      "root": "projects/dev-app",
      "sourceRoot": "projects/dev-app/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/dev-app",
            "index": "projects/dev-app/src/index.html",
            "main": "projects/dev-app/src/main.ts",
            "polyfills": "projects/dev-app/src/polyfills.ts",
            "tsConfig": "projects/dev-app/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "projects/dev-app/src/favicon.ico",
              "projects/dev-app/src/assets"
            ],
            "styles": [
              "node_modules/@ajf/icons/css/ajf-icons.css",
              "node_modules/@angular/material/prebuilt-themes/indigo-pink.css",
              "node_modules/flag-icon-css/css/flag-icons.min.css",
              "node_modules/leaflet/dist/leaflet.css",
              "projects/dev-app/src/styles.scss"
            ],
            "scripts": [],
            "allowedCommonJsDependencies": [
              "chart.js",
              "crypto-js/aes",
              "crypto-js/enc-utf8",
              "deep-equal",
              "immediate",
              "is-my-json-valid",
              "memdown",
              "modifyjs",
              "pdfmake/build/pdfmake",
              "graphql-ws"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "4mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "200kb",
                  "maximumError": "400kb"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "buildOptimizer": false,
              "optimization": false,
              "vendorChunk": true,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "browserTarget": "dev-app:build:production"
            },
            "development": {
              "browserTarget": "dev-app:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    },
    "dino-examples": {
      "projectType": "library",
      "root": "projects/dino-examples",
      "sourceRoot": "projects/dino-examples/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/dino-examples/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/dino-examples/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/dino-examples/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        }
      }
    }
  },
  "cli": {
    "cache": {
        "enabled": false
      },
      "schematicCollections": [
        "@angular-eslint/schematics"
      ]
  }
}
