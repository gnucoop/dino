/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": "./",
    "outDir": "../../out-tsc/material-spec",
    "types": [
      "echarts",
      "jasmine"
    ],
    "paths": {
      "@dino/core": ["../core"],
      "@dino/core/*": ["../core/*"],
      "@dino/material": ["."],
      "@dino/material/*": ["./*"],
      "assert": ["../../node_modules/assert"],
      "stream": ["../../node_modules/stream-browserify"]
    }
  },
  "files": [
    "src/test.ts"
  ],
  "include": [
    "**/*.spec.ts",
    "**/*.d.ts"
  ],
  "exclude": [
    "cypress/**/*.ts"
  ]
}
