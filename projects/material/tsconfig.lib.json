/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": "./",
    "outDir": "../../out-tsc/material",
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "types": ["echarts"],
    "paths": {
      "@dino/core": ["../../dist/core"],
      "@dino/core/*": ["../../dist/core/*"],
      "@dino/material": ["../../dist/material"],
      "@dino/material/*": ["../../dist/material/*"],
      "assert": ["../../node_modules/assert"],
      "stream": ["../../node_modules/stream-browserify"]
    }
  },
  "exclude": [
    "src/test.ts",
    "**/*.spec.ts"
  ]
}
