load("//src/e2e-app:test_suite.bzl", "e2e_test_suite")
load(
    "//tools:defaults.bzl",
    "markdown_to_html",
    "ng_e2e_test_library",
    "ng_module",
    "ng_test_library",
    "ng_web_test_suite",
    "sass_binary",
    "sass_library",
)

package(default_visibility = ["//visibility:public"])

ng_module(
    name = "import-form",
    srcs = glob(
        ["**/*.ts"],
        exclude = ["**/*.spec.ts"],
    ),
    assets = [
        ":import-form.css",
    ] + glob(["**/*.html"]),
    deps = [
        "//src/core/areas",
        "//src/core/cases",
        "//src/core/data",
        "//src/core/forms",
        "//src/core/locations",
        "//src/core/organizations",
        "//src/core/projects",
        "@npm//@ajf/core",
        "@npm//@ajf/material",
        "@npm//@angular/common",
        "@npm//@angular/core",
        "@npm//@angular/forms",
        "@npm//@angular/material",
        "@npm//date-fns",
        "@npm//xlsx",
    ],
)

sass_library(
    name = "import_form_scss_lib",
    srcs = glob(["**/_*.scss"]),
)

sass_binary(
    name = "import_form_scss",
    src = "import-form.scss",
    deps = [],
)

ng_test_library(
    name = "unit_test_sources",
    srcs = glob(
        ["**/*.spec.ts"],
        exclude = ["**/*.e2e.spec.ts"],
    ),
    deps = [
        ":import-form",
        "//src/core/auth",
        "//src/core/data",
        "//src/core/forms",
        "@npm//@angular/common",
        "@npm//@angular/forms",
        "@npm//@angular/material",
        "@npm//@angular/platform-browser",
        "@npm//@angular/router",
        "@npm//@types/pouchdb-adapter-memory",
        "@npm//rxdb",
        "@npm//rxjs",
    ],
)

ng_e2e_test_library(
    name = "e2e_test_sources",
    srcs = glob(["**/*.e2e.spec.ts"]),
    deps = [
        "//src/core/data",
        "//src/material/import-form",
        "@npm//@angular/core",
        "@npm//@angular/material",
    ],
)

ng_web_test_suite(
    name = "unit_tests",
    deps = [":unit_test_sources"],
)

e2e_test_suite(
    name = "e2e_tests",
    deps = [
        ":e2e_test_sources",
    ],
)

markdown_to_html(
    name = "overview",
    srcs = ["import-form.md"],
)

filegroup(
    name = "source-files",
    srcs = glob(["**/*.ts"]),
)
