load("//src/e2e-app:test_suite.bzl", "e2e_test_suite")
load(
    "//tools:defaults.bzl",
    "markdown_to_html",
    "ng_e2e_test_library",
    "ng_module",
    "ng_test_library",
    "ng_web_test_suite",
    "sass_binary",
    "sass_library",
)

package(default_visibility = ["//visibility:public"])

ng_module(
    name = "edit-report-schema",
    srcs = glob(
        ["**/*.ts"],
        exclude = ["**/*.spec.ts"],
    ),
    assets = [
        ":edit-report-schema.css",
        ":import-report-schema.css",
    ] + glob(["**/*.html"]),
    deps = [
        "//src/core/data",
        "//src/core/reports",
        "//src/material/icons-service",
        "@npm//@ajf/core",
        "@npm//@ajf/material",
        "@npm//@angular/common",
        "@npm//@angular/forms",
        "@npm//@angular/material",
        "@npm//@angular/router",
    ],
)

sass_library(
    name = "edit_report_schema_scss_lib",
    srcs = glob(["**/_*.scss"]),
)

sass_binary(
    name = "edit_report_schema_scss",
    src = "edit-report-schema.scss",
    deps = [],
)

sass_binary(
    name = "import_report_schema_scss",
    src = "import-report-schema.scss",
    deps = [],
)

ng_test_library(
    name = "unit_test_sources",
    srcs = glob(
        ["**/*.spec.ts"],
        exclude = ["**/*.e2e.spec.ts"],
    ),
    deps = [
        ":edit-report-schema",
        "//src/core/auth",
        "//src/core/data",
        "//src/core/reports",
        "@npm//@angular/common",
        "@npm//@angular/forms",
        "@npm//@angular/platform-browser",
        "@npm//@angular/router",
        "@npm//@types/pouchdb-adapter-memory",
        "@npm//rxdb",
        "@npm//rxjs",
    ],
)

ng_e2e_test_library(
    name = "e2e_test_sources",
    srcs = glob(["**/*.e2e.spec.ts"]),
    deps = [
        "//src/core/data",
        "//src/material/edit-report-schema",
        "@npm//@angular/core",
        "@npm//@angular/material",
    ],
)

ng_web_test_suite(
    name = "unit_tests",
    deps = [":unit_test_sources"],
)

e2e_test_suite(
    name = "e2e_tests",
    deps = [
        ":e2e_test_sources",
    ],
)

markdown_to_html(
    name = "overview",
    srcs = ["edit-report-schema.md"],
)

filegroup(
    name = "source-files",
    srcs = glob(["**/*.ts"]),
)
