load("//src/e2e-app:test_suite.bzl", "e2e_test_suite")
load(
    "//tools:defaults.bzl",
    "markdown_to_html",
    "ng_e2e_test_library",
    "ng_module",
    "ng_test_library",
    "ng_web_test_suite",
    "sass_binary",
    "sass_library",
)

package(default_visibility = ["//visibility:public"])

ng_module(
    name = "list",
    srcs = glob(
        ["**/*.ts"],
        exclude = ["**/*.spec.ts"],
    ),
    assets = [
        ":list.css",
        ":columns-selector.css",
        ":confirmation-dialog.css",
    ] + glob(["**/*.html"]),
    deps = [
        "//src/core/data",
        "//src/core/list",
        "//src/material/breakpoint-observer",
        "@npm//@angular/common",
        "@npm//@angular/forms",
        "@npm//@angular/material",
        "@npm//@angular/router",
    ],
)

sass_library(
    name = "list_scss_lib",
    srcs = glob(["**/_*.scss"]),
)

sass_binary(
    name = "list_scss",
    src = "list.scss",
    deps = [],
)

sass_binary(
    name = "columns_selector_scss",
    src = "columns-selector.scss",
    deps = [],
)

sass_binary(
    name = "confirmation_dialog_scss",
    src = "confirmation-dialog.scss",
    deps = [],
)

ng_test_library(
    name = "unit_test_sources",
    srcs = glob(
        ["**/*.spec.ts"],
        exclude = ["**/*.e2e.spec.ts"],
    ),
    deps = [
        ":list",
        "//src/core/auth",
        "//src/core/data",
        "//src/core/list",
        "@npm//@angular/common",
        "@npm//@angular/forms",
        "@npm//@angular/material",
        "@npm//@angular/router",
        "@npm//rxdb",
        "@npm//rxjs",
    ],
)

ng_e2e_test_library(
    name = "e2e_test_sources",
    srcs = glob(["**/*.e2e.spec.ts"]),
    deps = [
        "//src/core/data",
        "//src/material/list",
        "@npm//@angular/core",
        "@npm//@angular/material",
    ],
)

ng_web_test_suite(
    name = "unit_tests",
    deps = [":unit_test_sources"],
)

e2e_test_suite(
    name = "e2e_tests",
    deps = [
        ":e2e_test_sources",
    ],
)

markdown_to_html(
    name = "overview",
    srcs = ["list.md"],
)

filegroup(
    name = "source-files",
    srcs = glob(["**/*.ts"]),
)
