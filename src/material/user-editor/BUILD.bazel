load(
    "//tools:defaults.bzl",
    "markdown_to_html",
    "ng_module",
    "sass_binary",
    "sass_library",
)

package(default_visibility = ["//visibility:public"])

ng_module(
    name = "user-editor",
    srcs = glob(
        ["**/*.ts"],
        exclude = ["**/*.spec.ts"],
    ),
    assets = [
        ":user-editor.css",
    ] + glob(["**/*.html"]),
    module_name = "@dewco/material/user-editor",
    deps = [
        "//src/core/data",
        "//src/core/users",
        "//src/material/breakpoint-observer",
        "@npm//@angular/common",
        "@npm//@angular/forms",
        "@npm//@angular/material",
        "@npm//@angular/router",
    ],
)

sass_library(
    name = "user_editor_scss_lib",
    srcs = glob(["**/_*.scss"]),
)

sass_binary(
    name = "user_editor_scss",
    src = "user-editor.scss",
    deps = [],
)

markdown_to_html(
    name = "overview",
    srcs = ["user-editor.md"],
)

filegroup(
    name = "source-files",
    srcs = glob(["**/*.ts"]),
)
