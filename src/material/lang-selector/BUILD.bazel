load(
    "//tools:defaults.bzl",
    "markdown_to_html",
    "ng_module",
    "ng_test_library",
    "sass_binary",
    "sass_library",
)

package(default_visibility = ["//visibility:public"])

ng_module(
    name = "lang-selector",
    srcs = glob(
        ["**/*.ts"],
        exclude = ["**/*.spec.ts"],
    ),
    assets = [":lang-selector.css"] + glob(["**/*.html"]),
    module_name = "@dewco/material/lang-selector",
    deps = [
        "@npm//@ajf/core",
        "@npm//@angular/common",
        "@npm//@angular/forms",
        "@npm//@angular/material",
    ],
)

sass_library(
    name = "lang_selector_scss_lib",
    srcs = glob(["**/_*.scss"]),
)

sass_binary(
    name = "lang_selector_scss",
    src = "lang-selector.scss",
    deps = [],
)

ng_test_library(
    name = "unit_test_sources",
    srcs = glob(
        ["**/*.spec.ts"],
        exclude = ["**/*.e2e.spec.ts"],
    ),
    deps = [
    ],
)

markdown_to_html(
    name = "overview",
    srcs = ["lang-selector.md"],
)

filegroup(
    name = "source-files",
    srcs = glob(["**/*.ts"]),
)
