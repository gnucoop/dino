load(
    "//tools:defaults.bzl",
    "markdown_to_html",
    "ng_module",
    "sass_library",
)

package(default_visibility = ["//visibility:public"])

ng_module(
    name = "breakpoint-observer",
    srcs = glob(
        ["**/*.ts"],
        exclude = ["**/*.spec.ts"],
    ),
    deps = [
        "@npm//@angular/cdk",
        "@npm//@angular/common",
        "@npm//@angular/core",
        "@npm//rxjs",
    ],
)

sass_library(
    name = "breakpoint_observer_scss_lib",
    srcs = glob(["**/_*.scss"]),
)

markdown_to_html(
    name = "overview",
    srcs = ["breakpoint-observer.md"],
)

filegroup(
    name = "source-files",
    srcs = glob(["**/*.ts"]),
)
