load("//src/e2e-app:test_suite.bzl", "e2e_test_suite")
load(
    "//tools:defaults.bzl",
    "markdown_to_html",
    "ng_e2e_test_library",
    "ng_module",
    "ng_test_library",
    "ng_web_test_suite",
    "sass_binary",
    "sass_library",
)

package(default_visibility = ["//visibility:public"])

ng_module(
    name = "breadcrumbs",
    srcs = glob(
        ["**/*.ts"],
        exclude = ["**/*.spec.ts"],
    ),
    assets = [":breadcrumbs.css"] + glob(["**/*.html"]),
    deps = [
        "//src/core/auth",
        "//src/core/data",
        "//src/core/forms",
        "//src/core/reports",
        "//src/core/users",
        "//src/material/breakpoint-observer",
        "//src/material/lang-selector",
        "@npm//@angular/common",
        "@npm//@angular/material",
    ],
)

sass_library(
    name = "breadcrumbs_scss_lib",
    srcs = glob(["**/_*.scss"]),
)

sass_binary(
    name = "breadcrumbs_scss",
    src = "breadcrumbs.scss",
    deps = [],
)

ng_test_library(
    name = "unit_test_sources",
    srcs = glob(
        ["**/*.spec.ts"],
        exclude = ["**/*.e2e.spec.ts"],
    ),
    deps = [
        ":breadcrumbs",
        "//src/core/auth",
        "//src/core/data",
        "//src/core/users",
        "@npm//@angular/common",
        "@npm//@angular/forms",
        "@npm//@angular/platform-browser",
        "@npm//@angular/router",
        "@npm//@types/pouchdb-adapter-memory",
        "@npm//rxdb",
        "@npm//rxjs",
    ],
)

ng_e2e_test_library(
    name = "e2e_test_sources",
    srcs = glob(["**/*.e2e.spec.ts"]),
)

ng_web_test_suite(
    name = "unit_tests",
    deps = [":unit_test_sources"],
)

e2e_test_suite(
    name = "e2e_tests",
    deps = [
        ":e2e_test_sources",
    ],
)

markdown_to_html(
    name = "overview",
    srcs = ["breadcrumbs.md"],
)

filegroup(
    name = "source-files",
    srcs = glob(["**/*.ts"]),
)
