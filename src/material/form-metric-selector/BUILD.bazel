load(
    "//tools:defaults.bzl",
    "markdown_to_html",
    "ng_module",
    "sass_binary",
    "sass_library",
)

package(default_visibility = ["//visibility:public"])

ng_module(
    name = "form-metric-selector",
    srcs = glob(
        ["**/*.ts"],
        exclude = ["**/*.spec.ts"],
    ),
    assets = [
        ":form-metric-selector.css",
    ] + glob(["**/*.html"]),
    module_name = "@dewco/material/form-metric-selector",
    deps = [
        "//src/core/areas",
        "//src/core/data",
        "//src/core/forms",
        "//src/core/locations",
        "//src/core/organizations",
        "//src/core/projects",
        "//src/core/users",
        "//src/material/metric-editor",
        "@npm//@ajf/core",
        "@npm//@ajf/material",
        "@npm//@angular/common",
        "@npm//@angular/forms",
        "@npm//@angular/material",
        "@npm//@angular/router",
    ],
)

sass_library(
    name = "form_metric_selector_scss_lib",
    srcs = glob(["**/_*.scss"]),
)

sass_binary(
    name = "form_metric_selector_scss",
    src = "form-metric-selector.scss",
    deps = [],
)

markdown_to_html(
    name = "overview",
    srcs = ["form-metric-selector.md"],
)

filegroup(
    name = "source-files",
    srcs = glob(["**/*.ts"]),
)
