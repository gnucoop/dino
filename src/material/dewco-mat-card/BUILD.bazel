load("//src/e2e-app:test_suite.bzl", "e2e_test_suite")
load(
    "//tools:defaults.bzl",
    "markdown_to_html",
    "ng_e2e_test_library",
    "ng_module",
    "ng_test_library",
    "ng_web_test_suite",
    "sass_binary",
)

package(default_visibility = ["//visibility:public"])

ng_module(
    name = "dewco-mat-card",
    srcs = glob(
        ["**/*.ts"],
        exclude = ["**/*.spec.ts"],
    ),
    assets = [":dewco-mat-card.css"] + glob(["**/*.html"]),
    module_name = "@dewco/material/dewco-mat-card",
    deps = [
        "@npm//@angular/common",
        "@npm//@angular/material",
    ],
)

sass_binary(
    name = "dewco-mat-card_scss",
    src = "dewco-mat-card.scss",
    deps = [],
)

ng_test_library(
    name = "unit_test_sources",
    srcs = glob(
        ["**/*.spec.ts"],
        exclude = ["**/*.e2e.spec.ts"],
    ),
    deps = [
        ":dewco-mat-card",
        "@npm//@angular/material",
        "@npm//@angular/common",
    ],
)

ng_e2e_test_library(
    name = "e2e_test_sources",
    srcs = glob(["**/*.e2e.spec.ts"]),
)

ng_web_test_suite(
    name = "unit_tests",
    deps = [":unit_test_sources"],
)

e2e_test_suite(
    name = "e2e_tests",
    deps = [
        ":e2e_test_sources",
    ],
)

markdown_to_html(
    name = "overview",
    srcs = ["dewco-mat-card.md"],
)

filegroup(
    name = "source-files",
    srcs = glob(["**/*.ts"]),
)
