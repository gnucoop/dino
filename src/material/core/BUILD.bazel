load("//src/material:config.bzl", "MATERIAL_SCSS_LIBS")
load(
    "//tools:defaults.bzl",
    "markdown_to_html",
    "ng_module",
    "sass_binary",
    "sass_library",
)

package(default_visibility = ["//visibility:public"])

ALL_THEMING_FILES = [
    "_core.scss",
]

ng_module(
    name = "core",
    srcs = glob(
        ["**/*.ts"],
        exclude = ["**/*.spec.ts"],
    ),
    deps = [
        "@npm//@angular/core",
        "@npm//angular-material-css-vars",
    ],
)

sass_library(
    name = "theming_scss_lib",
    srcs = ALL_THEMING_FILES,
    deps = MATERIAL_SCSS_LIBS,
)

sass_binary(
    name = "dino_theme_prebuilt",
    src = "theming/prebuilt/dino-theme.scss",
    deps = [":theming_scss_lib"],
)

markdown_to_html(
    name = "overview",
    srcs = ["core.md"],
)

filegroup(
    name = "source-files",
    srcs = glob(["**/*.ts"]),
)
