load("//src/e2e-app:test_suite.bzl", "e2e_test_suite")
load(
    "//tools:defaults.bzl",
    "markdown_to_html",
    "ng_e2e_test_library",
    "ng_module",
    "sass_binary",
    "sass_library",
)

package(default_visibility = ["//visibility:public"])

ng_module(
    name = "metric-section",
    srcs = glob(
        ["**/*.ts"],
        exclude = ["**/*.spec.ts"],
    ),
    assets = [
        ":metric-section.css",
    ] + glob(["**/*.html"]),
    deps = [
        "//src/core/data",
        "//src/core/forms",
        "//src/core/list",
        "//src/material/breakpoint-observer",
        "//src/material/floating-button",
        "//src/material/list",
        "//src/material/metric-editor",
        "//src/material/search-filters-bar",
        "@npm//@angular/common",
        "@npm//@angular/forms",
        "@npm//@angular/material",
        "@npm//@angular/router",
    ],
)

sass_library(
    name = "metric_section_scss_lib",
    srcs = glob(["**/_*.scss"]),
)

sass_binary(
    name = "metric_section_scss",
    src = "metric-section.scss",
    deps = [],
)

ng_e2e_test_library(
    name = "e2e_test_sources",
    srcs = glob(["**/*.e2e.spec.ts"]),
    deps = [
        "//src/core/data",
        "//src/material/metric-section",
        "@npm//@angular/core",
        "@npm//@angular/material",
    ],
)

e2e_test_suite(
    name = "e2e_tests",
    deps = [
        ":e2e_test_sources",
    ],
)

markdown_to_html(
    name = "overview",
    srcs = ["metric-section.md"],
)

filegroup(
    name = "source-files",
    srcs = glob(["**/*.ts"]),
)
