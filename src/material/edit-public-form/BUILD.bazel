load(
    "//tools:defaults.bzl",
    "markdown_to_html",
    "ng_module",
    "sass_binary",
    "sass_library",
)

package(default_visibility = ["//visibility:public"])

ng_module(
    name = "edit-public-form",
    srcs = glob(
        ["**/*.ts"],
        exclude = ["**/*.spec.ts"],
    ),
    assets = [
        ":edit-public-form.css",
    ] + glob(["**/*.html"]),
    deps = [
        "//src/core/forms",
        "@npm//@ajf/material",
        "@npm//@angular/common",
        "@npm//@angular/core",
        "@npm//@angular/forms",
        "@npm//@angular/router",
        "@npm//@ngneat/transloco",
    ],
)

sass_library(
    name = "edit_public_form_scss_lib",
    srcs = glob(["**/_*.scss"]),
)

sass_binary(
    name = "edit_public_form_scss",
    src = "edit-public-form.scss",
    deps = [],
)

markdown_to_html(
    name = "overview",
    srcs = ["edit-public-form.md"],
)

filegroup(
    name = "source-files",
    srcs = glob(["**/*.ts"]),
)
