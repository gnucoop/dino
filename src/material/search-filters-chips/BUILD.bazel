load(
    "//tools:defaults.bzl",
    "markdown_to_html",
    "ng_module",
    "ng_test_library",
    "ng_web_test_suite",
    "sass_binary",
    "sass_library",
)
load("//tools/third-party-libs:index.bzl", "AJF_DEPS", "DATA_DEPS")

package(default_visibility = ["//visibility:public"])

ng_module(
    name = "search-filters-chips",
    srcs = glob(
        ["**/*.ts"],
        exclude = ["**/*.spec.ts"],
    ),
    assets = [":search-filters-chips.css"] + glob(["**/*.html"]),
    deps = [
        "//src/core/list",
        "@npm//@angular/common",
        "@npm//@angular/forms",
        "@npm//@angular/material",
        "@npm//@angular/router",
    ],
)

sass_library(
    name = "search_filters_chips_scss_lib",
    srcs = glob(["**/_*.scss"]),
)

sass_binary(
    name = "search_filters_chips_scss",
    src = "search-filters-chips.scss",
    deps = [],
)

ng_test_library(
    name = "unit_test_sources",
    srcs = glob(
        ["**/*.spec.ts"],
        exclude = ["**/*.e2e.spec.ts"],
    ),
    deps = [
        ":search-filters-chips",
        "//src/core/list",
        "@npm//@angular/common",
        "@npm//@angular/material",
        "@npm//@angular/router",
    ],
)

ng_web_test_suite(
    name = "unit_tests",
    deps = [":unit_test_sources"] + AJF_DEPS + DATA_DEPS,
)

markdown_to_html(
    name = "overview",
    srcs = ["search-filters-chips.md"],
)

filegroup(
    name = "source-files",
    srcs = glob(["**/*.ts"]),
)
