load(
    "//tools:defaults.bzl",
    "markdown_to_html",
    "ng_module",
    "sass_binary",
    "sass_library",
)

package(default_visibility = ["//visibility:public"])

ng_module(
    name = "edit-report",
    srcs = glob(
        ["**/*.ts"],
        exclude = ["**/*.spec.ts"],
    ),
    assets = [
        ":edit-report.css",
    ] + glob(["**/*.html"]),
    deps = [
        "//src/core/data",
        "//src/core/reports",
        "//src/material/form-metric-selector",
        "@npm//@ajf/core",
        "@npm//@ajf/material",
        "@npm//@angular/common",
        "@npm//@angular/forms",
        "@npm//@angular/material",
        "@npm//@angular/router",
    ],
)

sass_library(
    name = "edit_report_scss_lib",
    srcs = glob(["**/_*.scss"]),
)

sass_binary(
    name = "edit_report_scss",
    src = "edit-report.scss",
    deps = [],
)

markdown_to_html(
    name = "overview",
    srcs = ["edit-report.md"],
)

filegroup(
    name = "source-files",
    srcs = glob(["**/*.ts"]),
)
