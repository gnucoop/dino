load(
    "//tools:defaults.bzl",
    "markdown_to_html",
    "ng_module",
    "ng_test_library",
    "ng_web_test_suite",
    "sass_binary",
    "sass_library",
)

package(default_visibility = ["//visibility:public"])

ng_module(
    name = "metric-editor",
    srcs = glob(
        ["**/*.ts"],
        exclude = ["**/*.spec.ts"],
    ),
    assets = [
        ":metric-editor.css",
    ] + glob(["**/*.html"]),
    deps = [
        "//src/core/data",
        "//src/material/breakpoint-observer",
        "@npm//@angular/common",
        "@npm//@angular/forms",
        "@npm//@angular/material",
        "@npm//@angular/router",
    ],
)

sass_library(
    name = "metric_editor_scss_lib",
    srcs = glob(["**/_*.scss"]),
)

sass_binary(
    name = "metric_editor_scss",
    src = "metric-editor.scss",
    deps = [],
)

ng_test_library(
    name = "unit_test_sources",
    srcs = glob(
        ["**/*.spec.ts"],
        exclude = ["**/*.e2e.spec.ts"],
    ),
    deps = [
        ":metric-editor",
        "//src/core/areas",
        "//src/core/cases",
        "//src/core/auth",
        "//src/core/data",
        "@npm//@angular/common",
        "@npm//@angular/forms",
        "@npm//@angular/material",
        "@npm//@angular/platform-browser",
        "@npm//@angular/router",
        "@npm//rxdb",
        "@npm//rxjs",
    ],
)

ng_web_test_suite(
    name = "unit_tests",
    deps = [":unit_test_sources"],
)

markdown_to_html(
    name = "overview",
    srcs = ["metric-editor.md"],
)

filegroup(
    name = "source-files",
    srcs = glob(["**/*.ts"]),
)
