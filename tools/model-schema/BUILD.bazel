load("//src/core:config.bzl", "CORE_MODELS")
load("//tools:defaults.bzl", "ts_library")
load("//tools/model-schema:model-schema-targets.bzl", "model_schema_targets")

package(default_visibility = ["//visibility:public"])

exports_files(["tsconfig-generate.json"])

ts_library(
    name = "model-schema",
    srcs = ["model-schema.ts"],
    # TODO(ESM): remove this once the Bazel NodeJS rules can handle ESM with `nodejs_binary`.
    devmode_module = "commonjs",
    deps = [
        "@npm//:node_modules",
        "@npm//ts-json-schema-generator",
    ],
)

MODELS = ["core/%s-json.ts" % m for m in CORE_MODELS]

model_schema_targets(models = MODELS)
