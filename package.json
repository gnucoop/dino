    "e2e:core": "ng run core:cypress-open",
    "e2e:material": "ng run material:cypress-open",
    "e2e": "concurrently \"yarn dinoapp:e2e\" \"yarn e2e:core\" \"yarn e2e:material\"",
    "e2e-core": "concurrently \"yarn dinoapp:e2e\" \"yarn e2e:core\"",
    "e2e-material": "concurrently \"yarn dinoapp:e2e\" \"yarn e2e:material\"",
    "lint": "ng lint",
