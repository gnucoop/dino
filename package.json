    "approve-model-schema": "scripts/approve-model-schema.mjs",
    "prepare-release": "scripts/prepare-release.mjs",
    "release": "scripts/release.mjs",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "repomix-skill": "repomix --skill-generate --compress --remove-empty-lines"
